.gear {
  position: fixed;
  z-index: 60;
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.82);
  border: 1rpx solid rgba(24, 46, 72, 0.1);
  box-shadow: 0 6rpx 16rpx -8rpx rgba(24, 46, 72, 0.35);
}

.gear--hover {
  background: rgba(248, 250, 253, 0.95);
}

.gear-icon {
  font-size: 20px;
  line-height: 1;
  color: #3c4a5c;
}

.gear-dot {
  position: absolute;
  top: 3px;
  right: 3px;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #c8a03f;
}

.mask {
  position: fixed;
  z-index: 80;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(16, 26, 38, 0.44);
  display: flex;
  align-items: flex-end;
}

.panel {
  width: 100%;
  box-sizing: border-box;
  padding: 36rpx 40rpx calc(40rpx + env(safe-area-inset-bottom));
  border-radius: 32rpx 32rpx 0 0;
  background: #fbfdff;
}

.panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.panel-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1c2733;
  letter-spacing: 2rpx;
}

.panel-close {
  padding: 6rpx 10rpx;
  font-size: 30rpx;
  color: #8b97a6;
}

.panel-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #7c8896;
}

.field {
  margin-top: 28rpx;
}

.field-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #2c3a4b;
}

.field-tag {
  margin-left: 8rpx;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: #a3822f;
  background: rgba(200, 160, 63, 0.14);
  border-radius: 999rpx;
}

.field-input {
  margin-top: 12rpx;
  height: 80rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #1c2733;
  background: #ffffff;
  border: 1rpx solid rgba(24, 46, 72, 0.12);
  border-radius: 18rpx;
}

.field-ph {
  color: #b3bdc9;
}

.show-toggle {
  margin-top: 26rpx;
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #5c6a7b;
}

.show-box {
  width: 30rpx;
  height: 30rpx;
  margin-right: 12rpx;
  border-radius: 8rpx;
  border: 2rpx solid rgba(24, 46, 72, 0.25);
  box-sizing: border-box;
}

.show-box.is-on {
  background: #c8a03f;
  border-color: #c8a03f;
}

.panel-foot {
  margin-top: 36rpx;
  display: flex;
  gap: 24rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.btn--primary {
  color: #ffffff;
  background: linear-gradient(135deg, #d8b25c, #c8a03f);
  box-shadow: 0 12rpx 24rpx -12rpx rgba(200, 160, 63, 0.8);
}

.btn--ghost {
  color: #5c6a7b;
  background: #ffffff;
  border: 1rpx solid rgba(24, 46, 72, 0.14);
}
