.route,
.route view,
.route text {
  box-sizing: border-box;
}

.route {
  display: flex;
  align-items: center;
}

.now {
  font-family: "Songti SC", "STSong", "Noto Serif SC", "SimSun", serif;
  font-size: 30rpx;
  letter-spacing: 0.08em;
  color: #e3c766;
}

.total {
  margin-left: 8rpx;
  font-size: 20rpx;
  letter-spacing: 0.1em;
  color: rgba(242, 235, 221, 0.42);
}

.ticks {
  position: relative;
  display: flex;
  align-items: center;
  margin-left: 16rpx;
}

.rail {
  position: absolute;
  left: 11rpx;
  right: 11rpx;
  top: 50%;
  height: 2rpx;
  margin-top: -1rpx;
  background: rgba(242, 235, 221, 0.14);
}

.rail-fill {
  width: 100%;
  height: 100%;
  transform: scaleX(0);
  transform-origin: 0 50%;
  background: linear-gradient(90deg, rgba(201, 162, 39, 0.5) 0%, #c9a227 100%);
  transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.tick {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 22rpx;
  height: 44rpx;
}

.tick-line {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: rgba(242, 235, 221, 0.3);
  transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), background 0.25s;
}

.tick.is-on .tick-line {
  background: rgba(201, 162, 39, 0.75);
}

.tick.is-cur .tick-line {
  transform: scale(1.9);
  background: #f2ebdd;
}
