{
  "name": "travel-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "游览向导服务端：静态发布 + 生成任务编排",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "tts:check": "node --env-file-if-exists=.env src/scripts/tts-check.ts",
    "audio:backfill": "node --env-file-if-exists=.env src/scripts/audio-backfill.ts",
    "hot:stats": "node --env-file-if-exists=.env src/scripts/hot-stats.ts",
    "hot:pregen": "node --env-file-if-exists=.env src/scripts/hot-pregen.ts",
    "db:import-attractions": "node --env-file-if-exists=.env src/scripts/import-attractions.ts",
    "test": "node --test --test-concurrency=1 \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@fastify/static": "^8.2.0",
    "fastify": "^5.3.0",
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.0"
  }
}
